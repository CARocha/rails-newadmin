<%= render "rails_newadmin/shared/errors", record: @group, scope: :group, fields: [:name] %>
<%= form_with scope: :group, url: @group.persisted? ? group_path(@group) : groups_path, method: @group.persisted? ? :patch : :post do |form| %>
  <div class="newadmin-field"><%= form.label :name, t("rails_newadmin.access.name") %><%= form.text_field :name, **field_error_attributes(@group, :name, scope: :group), required: true, value: @group.name %><%= render "rails_newadmin/shared/field_error", record: @group, field: :name, scope: :group %></div>
  <fieldset class="newadmin-permissions"><legend><%= t("rails_newadmin.access.permissions") %></legend>
    <%= hidden_field_tag "group[permission_ids][]", "" %>
    <% @permissions.group_by(&:resource_key).each do |key, permissions| %>
      <fieldset><legend><%= key %></legend><% permissions.each do |permission| %>
        <label><%= check_box_tag "group[permission_ids][]", permission.id, @group.permission_ids.include?(permission.id), id: "permission_#{permission.id}" %> <%= t("rails_newadmin.permissions.#{permission.action}") %></label>
      <% end %></fieldset>
    <% end %>
  </fieldset>
  <div class="newadmin-form-actions"><%= form.submit t("rails_newadmin.crud.save"), class: "btn btn-primary" %><%= link_to t("rails_newadmin.crud.cancel"), groups_path %></div>
<% end %>
