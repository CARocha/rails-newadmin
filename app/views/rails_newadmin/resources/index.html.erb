<div class="newadmin-page-heading">
  <div><p class="newadmin-eyebrow"><%= t("rails_newadmin.crud.resources") %></p><h1><%= resource_label %></h1></div>
  <% if @access.allowed?(:create) %><%= link_to t("rails_newadmin.crud.new"), new_resource_record_path(@resource.resource_key), class: "btn btn-primary" %><% end %>
</div>
<section class="newadmin-panel">
  <%= form_with url: resource_records_path(@resource.resource_key), method: :get, class: "newadmin-filters" do |form| %>
    <%= form.label :q, t("rails_newadmin.crud.search") %>
    <%= form.search_field :q, value: params[:q], maxlength: 200 %>
    <% @resource.filter_fields.each do |field| %>
      <%= label_tag "filters_#{field}", @resource.model_class.human_attribute_name(field) %>
      <%= text_field_tag "filters[#{field}]", params.dig(:filters, field), id: "filters_#{field}", maxlength: 200 %>
    <% end %>
    <%= form.submit t("rails_newadmin.crud.filter"), class: "btn btn-secondary" %>
  <% end %>
  <div class="newadmin-table-scroll" tabindex="0" role="region" aria-label="<%= resource_label %>">
    <table><thead><tr>
      <% @resource.column_names.each do |field| %><th scope="col"><%= @resource.model_class.human_attribute_name(field) %></th><% end %>
      <th scope="col"><%= t("rails_newadmin.crud.actions") %></th>
    </tr></thead><tbody>
      <% @records.each do |record| %><tr>
        <% @resource.column_names.each do |field| %><td><%= record[field] %></td><% end %>
        <td class="newadmin-row-actions"><%= link_to t("rails_newadmin.crud.view"), resource_record_path(@resource.resource_key, record) %>
          <% if @access.allowed?(:update, record) %><%= link_to t("rails_newadmin.crud.edit"), edit_resource_record_path(@resource.resource_key, record) %><% end %>
        </td>
      </tr><% end %>
      <% if @records.empty? %><tr><td colspan="<%= @resource.column_names.size + 1 %>"><%= t("rails_newadmin.crud.empty") %></td></tr><% end %>
    </tbody></table>
  </div>
  <nav class="newadmin-pagination" aria-label="<%= t("rails_newadmin.crud.pagination") %>">
    <span><%= t("rails_newadmin.crud.results", count: @total) %></span>
    <% if @query.page > 1 %><%= link_to t("rails_newadmin.crud.previous"), resource_records_path(@resource.resource_key, page: @query.page - 1, q: params[:q]) %><% end %>
    <% if @query.page * @query.per_page < @total %><%= link_to t("rails_newadmin.crud.next"), resource_records_path(@resource.resource_key, page: @query.page + 1, q: params[:q]) %><% end %>
  </nav>
</section>
